{
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",

    "test": "npm run test:endpoint && npm run test:repository && npm run test:service",
    "test:endpoint": "dotenv -e .env.test --override -- vitest run --config vitest.endpoint.config.mts",
    "test:repository": "dotenv -e .env.test --override -- vitest run --config vitest.repository.config.mts",
    "test:service": "vitest run --config vitest.service.config.mts",
    "test:watch": "vitest",

    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:test:migrate": "dotenv -e .env.test --override -- drizzle-kit migrate"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
